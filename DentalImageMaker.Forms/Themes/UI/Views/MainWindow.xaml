<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:support="clr-namespace:DentalImageMaker.Support.UI.Units;assembly=DentalImageMaker.Support"
    xmlns:units="clr-namespace:DentalImageMaker.Forms.UI.Units"
    xmlns:views="clr-namespace:DentalImageMaker.Forms.UI.Views">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DentalImageMaker.Forms;component/Themes/SharedStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <units:PathToImageConverter x:Key="Thumb" DecodeWidth="240" />
    <units:PathToImageConverter x:Key="SmallThumb" DecodeWidth="96" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!--  치식 차트의 치아 한 칸: 위에 번호, 아래에 상태 약자. 고른 칸은 청록 테두리.  -->
    <DataTemplate x:Key="ToothTemplate">
        <Button
            Width="24"
            Height="34"
            Margin="1,0"
            Command="{Binding DataContext.ToggleToothCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CommandParameter="{Binding}"
            Cursor="Hand"
            ToolTip="{Binding ToolTip}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Box"
                        Background="{Binding Condition.Color}"
                        BorderBrush="#555555"
                        BorderThickness="1"
                        CornerRadius="3">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="10"
                                Foreground="#DDDDDD"
                                Text="{Binding Number}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="9"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{Binding Condition.Short}">
                                <TextBlock.Effect>
                                    <DropShadowEffect
                                        BlurRadius="2"
                                        Opacity="1"
                                        ShadowDepth="0"
                                        Color="Black" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#4EC9B0" />
                            <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="ToothRow">
        <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,14,0,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#9CDCFE" />
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#888888" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DarkCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#DDDDDD" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <Style x:Key="DarkRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#DDDDDD" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,16,0" />
    </Style>

    <Style
        x:Key="ChipButton"
        BasedOn="{StaticResource SecondaryButtonStyle}"
        TargetType="Button">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="13">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        예제 그림 카드로 고르는 칸 목록(카메라 구도·치과의사·치과위생사 공통).
        칸을 누르면 OptionPickerWindow 가 뜬다. 고른 칸은 초록 테두리.
    -->
    <Style x:Key="SlotList" TargetType="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Margin="0,0,6,6">
                        <TextBlock Style="{StaticResource HintText}" Text="{Binding Title}" />
                        <Button
                            Height="48"
                            Command="{Binding DataContext.PickOptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Cursor="Hand"
                            ToolTip="{Binding PromptText}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="Bd"
                                        Background="#2D2D2D"
                                        BorderBrush="#3C3C3C"
                                        BorderThickness="1">
                                        <DockPanel>
                                            <Border
                                                Width="64"
                                                Background="#1A1A1A"
                                                DockPanel.Dock="Left">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock
                                                Margin="8,0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="White"
                                                Text="{Binding Selected.Name}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSet}" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#10A37F" />
                                        </DataTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="MultiLineBox"
        BasedOn="{StaticResource DarkTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style BasedOn="{StaticResource {x:Type support:DentalWindow}}" TargetType="{x:Type views:MainWindow}">
        <Setter Property="Title" Value="치과 이미지 메이커" />
        <Setter Property="Width" Value="1400" />
        <Setter Property="Height" Value="900" />
        <Setter Property="MinWidth" Value="1000" />
        <Setter Property="MinHeight" Value="640" />

        <!--  타이틀바 가운데: 보낼 서비스 고르기. 고른 서비스의 브라우저가 오른쪽에 뜬다.  -->
        <Setter Property="TitleBarContent">
            <Setter.Value>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <ToggleButton
                        Width="100"
                        Height="26"
                        Content="Gemini"
                        IsChecked="{Binding IsGemini, Mode=TwoWay}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="#3C3C3C" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0078D4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <ToggleButton
                        Width="100"
                        Height="26"
                        Margin="6,0,0,0"
                        Content="ChatGPT"
                        IsChecked="{Binding IsChatGpt, Mode=TwoWay}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="#3C3C3C" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#10A37F" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </StackPanel>
            </Setter.Value>
        </Setter>

        <Setter Property="Content">
            <Setter.Value>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="440" MinWidth="360" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  ===== 왼쪽: 프롬프트 만들기 =====  -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Padding="16,4,16,8" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="종류" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton
                                        Content="이미지"
                                        GroupName="Kind"
                                        IsChecked="{Binding IsImageKind, Mode=TwoWay}"
                                        Style="{StaticResource DarkRadio}" />
                                    <RadioButton
                                        Content="영상 (Gemini)"
                                        GroupName="Kind"
                                        IsChecked="{Binding IsVideoKind, Mode=TwoWay}"
                                        IsEnabled="{Binding CanUseVideo}"
                                        Style="{StaticResource DarkRadio}" />
                                </StackPanel>

                                <!--  만들 장면: 치과 상황(진료실 장면) / 환자 입안(입안 클로즈업). 고른 쪽 칸만 아래에 보인다.  -->
                                <TextBlock Style="{StaticResource SectionLabel}" Text="만들 장면" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton
                                        Content="치과 상황"
                                        GroupName="Target"
                                        IsChecked="{Binding IsSceneMode, Mode=TwoWay}"
                                        Style="{StaticResource DarkRadio}" />
                                    <RadioButton
                                        Content="환자 입안"
                                        GroupName="Target"
                                        IsChecked="{Binding IsMouthMode, Mode=TwoWay}"
                                        Style="{StaticResource DarkRadio}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsSceneMode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="치과 상황" />
                                    <ItemsControl
                                        Margin="0,4,0,0"
                                        ItemsSource="{Binding SituationSlots}"
                                        Style="{StaticResource SlotList}" />
                                    <TextBlock Style="{StaticResource HintText}" Text="상황을 고르면 그 장면에 맞지 않는 칸(치료 종류·치식 차트 등)은 숨겨지고 프롬프트에서도 빠진다." />
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsMouthMode, Converter={StaticResource BoolToVis}}">
                                    <DockPanel Margin="0,14,0,0">
                                        <Button
                                            Width="60"
                                            Height="22"
                                            Command="{Binding ResetMouthCommand}"
                                            Content="초기화"
                                            DockPanel.Dock="Right"
                                            FontSize="11"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                        <TextBlock
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SectionLabel}"
                                            Text="환자 입안" />
                                    </DockPanel>
                                    <ItemsControl
                                        Margin="0,4,0,0"
                                        ItemsSource="{Binding MouthSlots}"
                                        Style="{StaticResource SlotList}" />
                                    <TextBlock Style="{StaticResource HintText}" Text="입안 클로즈업을 만든다. 치과의사·위생사와 카메라의 시점·앵글·샷 크기는 숨겨진다. 치료 부위가 잘 보이게 하려면 '볼 당김'을 고른다(손은 '손·기구'에서 고른다). 코~턱처럼 눈이 화면 밖인 범위는 환자 외모 문장도 뺀다." />
                                </StackPanel>

                                <DockPanel Margin="0,14,0,6">
                                    <Button
                                        Width="60"
                                        Height="24"
                                        Margin="6,0,0,0"
                                        Command="{Binding ClearReferencesCommand}"
                                        Content="비우기"
                                        DockPanel.Dock="Right"
                                        FontSize="12"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button
                                        Width="60"
                                        Height="24"
                                        Margin="6,0,0,0"
                                        Command="{Binding AddReferencesCommand}"
                                        Content="추가"
                                        DockPanel.Dock="Right"
                                        FontSize="12"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button
                                        Width="80"
                                        Height="24"
                                        Command="{Binding PasteReferenceCommand}"
                                        Content="붙여넣기"
                                        DockPanel.Dock="Right"
                                        FontSize="12"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="클립보드의 그림(캡처·이미지 복사)이나 복사한 파일을 첨부" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionLabel}"
                                        Margin="0"
                                        Text="{Binding ReferenceLabel}" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding References}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Width="76"
                                                Height="76"
                                                Margin="0,0,6,6"
                                                Background="#2D2D2D"
                                                BorderBrush="#3C3C3C"
                                                BorderThickness="1"
                                                ToolTip="{Binding}">
                                                <Grid>
                                                    <Image Source="{Binding Converter={StaticResource SmallThumb}}" Stretch="UniformToFill" />
                                                    <Button
                                                        Width="20"
                                                        Height="20"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Command="{Binding DataContext.RemoveReferenceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="✕"
                                                        FontSize="10"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="화풍" />
                                        <ComboBox
                                            ItemsSource="{Binding Styles}"
                                            SelectedItem="{Binding SelectedStyle}"
                                            Style="{StaticResource DarkComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="비율" />
                                        <ComboBox
                                            ItemsSource="{Binding AspectRatios}"
                                            SelectedItem="{Binding SelectedAspect}"
                                            Style="{StaticResource DarkComboBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <!--  등장인물: 고른 값은 settings.json 에 저장돼 다음 실행에도 같은 주인공으로 시작한다  -->
                                <DockPanel Margin="0,14,0,0" Visibility="{Binding IsSceneMode, Converter={StaticResource BoolToVis}}">
                                    <Button
                                        Width="60"
                                        Height="22"
                                        Command="{Binding ResetDentistCommand}"
                                        Content="초기화"
                                        DockPanel.Dock="Right"
                                        FontSize="11"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <CheckBox
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Content="프롬프트에 넣기"
                                        DockPanel.Dock="Right"
                                        IsChecked="{Binding IncludeDentist}"
                                        Style="{StaticResource DarkCheck}" />
                                    <TextBlock
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionLabel}"
                                        Text="치과의사 (주인공)"
                                        ToolTip="기본값: 20대 후반 여성, 낮은 포니테일, 흰 가운 + 네이비 스크럽, 마스크 착용" />
                                </DockPanel>
                                <ItemsControl
                                    Visibility="{Binding IsSceneMode, Converter={StaticResource BoolToVis}}"
                                    Margin="0,4,0,0"
                                    IsEnabled="{Binding IncludeDentist}"
                                    ItemsSource="{Binding DentistSlots}"
                                    Style="{StaticResource SlotList}" />

                                <DockPanel Margin="0,14,0,0" Visibility="{Binding IsSceneMode, Converter={StaticResource BoolToVis}}">
                                    <Button
                                        Width="60"
                                        Height="22"
                                        Command="{Binding ResetHygienistCommand}"
                                        Content="초기화"
                                        DockPanel.Dock="Right"
                                        FontSize="11"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <CheckBox
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Content="프롬프트에 넣기"
                                        DockPanel.Dock="Right"
                                        IsChecked="{Binding IncludeHygienist}"
                                        Style="{StaticResource DarkCheck}" />
                                    <TextBlock
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionLabel}"
                                        Text="치과위생사"
                                        ToolTip="위생사가 나오는 장면에서만 켠다" />
                                </DockPanel>
                                <ItemsControl
                                    Visibility="{Binding IsSceneMode, Converter={StaticResource BoolToVis}}"
                                    Margin="0,4,0,0"
                                    IsEnabled="{Binding IncludeHygienist}"
                                    ItemsSource="{Binding HygienistSlots}"
                                    Style="{StaticResource SlotList}" />

                                <DockPanel Margin="0,14,0,0">
                                    <Button
                                        Width="60"
                                        Height="22"
                                        Command="{Binding ResetPatientCommand}"
                                        Content="초기화"
                                        DockPanel.Dock="Right"
                                        FontSize="11"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <CheckBox
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Content="프롬프트에 넣기"
                                        DockPanel.Dock="Right"
                                        IsChecked="{Binding IncludePatient}"
                                        Style="{StaticResource DarkCheck}" />
                                    <TextBlock
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionLabel}"
                                        Text="환자"
                                        ToolTip="고른 칸만 프롬프트에 붙는다. 입안 클로즈업에서는 성별·나이만 붙는다." />
                                </DockPanel>
                                <ItemsControl
                                    Margin="0,4,0,0"
                                    IsEnabled="{Binding IncludePatient}"
                                    ItemsSource="{Binding PatientSlots}"
                                    Style="{StaticResource SlotList}" />

                                <!--  치식 차트: 치아를 눌러 고른 뒤 상태 칩을 누른다. settings.json 에 저장된다.  -->
                                <StackPanel IsEnabled="{Binding IncludePatient}" Visibility="{Binding ShowToothChart, Converter={StaticResource BoolToVis}}">
                                    <DockPanel Margin="0,10,0,4">
                                        <Button
                                            Width="76"
                                            Height="22"
                                            Command="{Binding ClearToothChartCommand}"
                                            Content="차트 비우기"
                                            DockPanel.Dock="Right"
                                            FontSize="11"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#CCCCCC"
                                            Text="치식 차트 (FDI · 화면 왼쪽 = 환자 오른쪽)" />
                                    </DockPanel>
                                    <Viewbox
                                        MaxWidth="408"
                                        HorizontalAlignment="Left"
                                        Stretch="Uniform"
                                        StretchDirection="DownOnly">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="9" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="9" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ItemsControl
                                                ItemTemplate="{StaticResource ToothTemplate}"
                                                ItemsPanel="{StaticResource ToothRow}"
                                                ItemsSource="{Binding UpperRightTeeth}" />
                                            <ItemsControl
                                                Grid.Column="2"
                                                ItemTemplate="{StaticResource ToothTemplate}"
                                                ItemsPanel="{StaticResource ToothRow}"
                                                ItemsSource="{Binding UpperLeftTeeth}" />
                                            <ItemsControl
                                                Grid.Row="2"
                                                ItemTemplate="{StaticResource ToothTemplate}"
                                                ItemsPanel="{StaticResource ToothRow}"
                                                ItemsSource="{Binding LowerRightTeeth}" />
                                            <ItemsControl
                                                Grid.Row="2"
                                                Grid.Column="2"
                                                ItemTemplate="{StaticResource ToothTemplate}"
                                                ItemsPanel="{StaticResource ToothRow}"
                                                ItemsSource="{Binding LowerLeftTeeth}" />
                                            <Border
                                                Grid.RowSpan="3"
                                                Grid.Column="1"
                                                Width="1"
                                                Background="#777777" />
                                            <Border
                                                Grid.Row="1"
                                                Grid.ColumnSpan="3"
                                                Height="1"
                                                Background="#777777" />
                                        </Grid>
                                    </Viewbox>
                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ToothConditions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Height="22"
                                                    Padding="6,0"
                                                    Command="{Binding DataContext.ApplyToothConditionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    FontSize="11"
                                                    Style="{StaticResource ChipButton}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border
                                                            Width="10"
                                                            Height="10"
                                                            Margin="0,0,4,0"
                                                            Background="{Binding Color}"
                                                            BorderBrush="#888888"
                                                            BorderThickness="1"
                                                            CornerRadius="2" />
                                                        <TextBlock Text="{Binding Name}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource HintText}" Text="{Binding ToothChartSummary}" />
                                </StackPanel>

                                <DockPanel Margin="0,14,0,0" Visibility="{Binding ShowTreatmentSection, Converter={StaticResource BoolToVis}}">
                                    <Button
                                        Width="60"
                                        Height="22"
                                        Command="{Binding ResetTreatmentCommand}"
                                        Content="초기화"
                                        DockPanel.Dock="Right"
                                        FontSize="11"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <TextBlock
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionLabel}"
                                        Text="진료 내용 · 진료실"
                                        ToolTip="입안 장면은 치료 종류·치아 위치를 고르고 샷 크기를 'ECU 구강 내부'로 두면 잘 나온다" />
                                </DockPanel>
                                <ItemsControl
                                    Margin="0,4,0,0"
                                    ItemsSource="{Binding TreatmentSlots}"
                                    Style="{StaticResource SlotList}" />

                                <!--  카메라 구도: 각도·방향은 숫자를 넣은 별도 문장으로 붙는다  -->
                                <DockPanel Margin="0,14,0,0">
                                    <Button
                                        Width="60"
                                        Height="22"
                                        Command="{Binding ResetCameraCommand}"
                                        Content="초기화"
                                        DockPanel.Dock="Right"
                                        FontSize="11"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <TextBlock
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionLabel}"
                                        Text="카메라 구도" />
                                </DockPanel>
                                <ItemsControl
                                    Margin="0,4,0,0"
                                    ItemsSource="{Binding CameraSlots}"
                                    Style="{StaticResource SlotList}" />

                                <DockPanel Margin="0,14,0,6">
                                    <Button
                                        Width="80"
                                        Height="22"
                                        Command="{Binding AddFreeTextToRulesCommand}"
                                        Content="규칙에 추가"
                                        DockPanel.Dock="Right"
                                        FontSize="11"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="내용의 줄마다 치과 규칙으로 저장(다음 실행에도 유지)하고 칸을 비움" />
                                    <TextBlock
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionLabel}"
                                        Text="내용 (장면 설명·대사·수정 요청)" />
                                </DockPanel>
                                <TextBox
                                    MinHeight="90"
                                    MaxHeight="220"
                                    Style="{StaticResource MultiLineBox}"
                                    Text="{Binding FreeText, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource SectionLabel}" Text="내 수정 요청 (누르면 내용에 붙고 '이어서 보내기'가 켜짐 · 우클릭 삭제)" />
                                <TextBlock Style="{StaticResource HintText}" Text="내용 칸에 수정 요청을 적어 '이어서 보내기'로 보내면 여기에 등록된다." />
                                <ItemsControl ItemsSource="{Binding EditRequests}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Command="{Binding DataContext.AppendChipCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding}"
                                                Style="{StaticResource ChipButton}">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem
                                                            Command="{Binding PlacementTarget.Tag.RemoveEditRequestCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            CommandParameter="{Binding}"
                                                            Header="삭제" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <Button.Tag>
                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </Button.Tag>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Style="{StaticResource SectionLabel}" Text="치과 규칙 (프롬프트 끝에 붙음)" />
                                <TextBlock Style="{StaticResource HintText}" Text="치과 상황을 상담·양치 등으로 고르면 ★ 규칙(진료 중 전용)은 자동으로 빠진다." />
                                <ItemsControl ItemsSource="{Binding Rules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Button
                                                    Width="20"
                                                    Height="20"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="✕"
                                                    DockPanel.Dock="Right"
                                                    FontSize="10"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    ToolTip="이 규칙 삭제"
                                                    Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}" />
                                                <CheckBox
                                                    Content="{Binding DisplayName}"
                                                    IsChecked="{Binding IsOn}"
                                                    Style="{StaticResource DarkCheck}"
                                                    ToolTip="{Binding Rule.Text}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>


                                <CheckBox
                                    Margin="0,10,0,0"
                                    Content="지금 채팅에 이어서 보내기 (수정 요청 — 머리말 생략, 적은 요청은 아래 칩으로 등록)"
                                    IsChecked="{Binding ContinueChat}"
                                    Style="{StaticResource DarkCheck}" />

                                <TextBlock Style="{StaticResource SectionLabel}" Text="파일 이름 (비우면 시간으로)" />
                                <TextBox Style="{StaticResource DarkTextBoxStyle}" Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}" />

                                <DockPanel Margin="0,14,0,6">
                                    <Button
                                        Width="60"
                                        Height="24"
                                        Command="{Binding CopyPromptCommand}"
                                        Content="복사"
                                        DockPanel.Dock="Right"
                                        FontSize="12"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <TextBlock
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionLabel}"
                                        Text="보낼 프롬프트" />
                                </DockPanel>
                                <TextBox
                                    MinHeight="80"
                                    MaxHeight="200"
                                    Foreground="#BBBBBB"
                                    IsReadOnly="True"
                                    Style="{StaticResource MultiLineBox}"
                                    Text="{Binding FinalPrompt, Mode=OneWay}" />

                                <TextBlock Style="{StaticResource SectionLabel}" Text="대기열" />
                                <ListBox
                                    MaxHeight="200"
                                    Background="#252526"
                                    BorderBrush="#3C3C3C"
                                    Foreground="#DDDDDD"
                                    ItemsSource="{Binding Queue}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2" ToolTip="{Binding Prompt}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="44"
                                                        Foreground="#9CDCFE"
                                                        Text="{Binding StatusText}" />
                                                    <TextBlock
                                                        Width="62"
                                                        Foreground="#888888"
                                                        Text="{Binding Provider}" />
                                                    <TextBlock Text="{Binding Name}" />
                                                </StackPanel>
                                                <TextBlock
                                                    MaxWidth="360"
                                                    FontSize="11"
                                                    Foreground="#888888"
                                                    Text="{Binding Message}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                    <Button
                                        Width="110"
                                        Height="28"
                                        Command="{Binding LoadQueueCommand}"
                                        Content="JSON 불러오기"
                                        FontSize="12"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button
                                        Width="90"
                                        Height="28"
                                        Margin="6,0,0,0"
                                        Command="{Binding ClearQueueCommand}"
                                        Content="목록 비우기"
                                        FontSize="12"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button
                                        Width="110"
                                        Height="28"
                                        Margin="6,0,0,0"
                                        Command="{Binding OpenSiteSettingsCommand}"
                                        Content="선택자 설정 열기"
                                        FontSize="12"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="사이트 화면이 바뀌어 자동 조작이 안 될 때 sites.json 을 고친다" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!--  하단 고정: 실행 버튼과 상태  -->
                        <Border
                            Grid.Row="1"
                            Padding="16,10"
                            Background="#252526"
                            BorderBrush="#3C3C3C"
                            BorderThickness="0,1,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Command="{Binding GenerateCommand}"
                                        Content="생성"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        Grid.Column="2"
                                        Command="{Binding AddToQueueCommand}"
                                        Content="대기열에 추가"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button
                                        Grid.Column="4"
                                        Command="{Binding RunQueueCommand}"
                                        Content="대기열 실행"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button
                                        Grid.Column="6"
                                        Command="{Binding StopCommand}"
                                        Content="중지"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontSize="12"
                                    Foreground="#CCCCCC"
                                    Text="{Binding Status}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <GridSplitter
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Background="#2D2D2D" />

                    <!--  ===== 오른쪽: 브라우저 + 결과 =====  -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  MainWindow.cs 가 서비스별 WebView2 를 여기에 넣는다  -->
                        <units:BrowserHost />

                        <Border
                            Grid.Row="1"
                            Height="180"
                            Background="#252526"
                            BorderBrush="#3C3C3C"
                            BorderThickness="0,1,0,0">
                            <DockPanel>
                                <DockPanel Margin="12,6" DockPanel.Dock="Top">
                                    <Button
                                        Width="80"
                                        Height="24"
                                        Margin="6,0,0,0"
                                        Command="{Binding ChangeOutputFolderCommand}"
                                        Content="폴더 변경"
                                        DockPanel.Dock="Right"
                                        FontSize="12"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button
                                        Width="80"
                                        Height="24"
                                        Command="{Binding OpenOutputFolderCommand}"
                                        Content="폴더 열기"
                                        DockPanel.Dock="Right"
                                        FontSize="12"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#9CDCFE"
                                        Text="{Binding OutputFolder, StringFormat=결과  —  {0}}"
                                        TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <ListBox
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding Results}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="140" ToolTip="{Binding Prompt}">
                                                <Border
                                                    Height="100"
                                                    Background="#1E1E1E"
                                                    BorderBrush="#3C3C3C"
                                                    BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Foreground="#888888"
                                                            Text="▶ 영상" />
                                                        <Image Source="{Binding Path, Converter={StaticResource Thumb}}" Stretch="Uniform" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="11"
                                                    Foreground="#CCCCCC"
                                                    Text="{Binding FileName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button
                                                        Width="66"
                                                        Height="20"
                                                        Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Content="열기"
                                                        FontSize="11"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                                    <Button
                                                        Width="66"
                                                        Height="20"
                                                        Margin="4,0,0,0"
                                                        Command="{Binding DataContext.UseResultAsReferenceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Content="참고로"
                                                        FontSize="11"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        ToolTip="다음 요청의 참고 이미지로 첨부" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
