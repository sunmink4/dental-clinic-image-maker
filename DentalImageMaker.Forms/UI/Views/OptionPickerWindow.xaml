<support:DentalWindow
    x:Class="DentalImageMaker.Forms.UI.Views.OptionPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:support="clr-namespace:DentalImageMaker.Support.UI.Units;assembly=DentalImageMaker.Support"
    Width="1080"
    Height="760"
    MinWidth="600"
    MinHeight="400"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <support:DentalWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DentalImageMaker.Forms;component/Themes/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </support:DentalWindow.Resources>

    <DockPanel>
        <TextBlock
            Margin="20,12,20,4"
            DockPanel.Dock="Top"
            FontSize="12"
            Foreground="#888888"
            Text="카드를 누르면 선택됩니다. 예제는 지금까지 만든 그림이고, '예제 바꾸기'로 내 그림으로 바꿀 수 있습니다."
            TextWrapping="Wrap" />

        <ScrollViewer Padding="16,8,16,16" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Cards">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Width="240"
                            Margin="0,0,12,12"
                            Click="OnCardClick"
                            Cursor="Hand"
                            Tag="{Binding}"
                            ToolTip="{Binding Description}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="Bd"
                                        Padding="8"
                                        Background="#252526"
                                        BorderBrush="#3C3C3C"
                                        BorderThickness="2"
                                        CornerRadius="6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#10A37F" />
                                            <Setter TargetName="Bd" Property="Background" Value="#1F3A33" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <Border Height="150" Background="#1A1A1A">
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#666666"
                                            Text="예제 없음" />
                                        <Image Source="{Binding Image}" Stretch="Uniform" />
                                    </Grid>
                                </Border>
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    Height="44"
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    Foreground="#999999"
                                    Text="{Binding Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <Button
                                    Height="22"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Right"
                                    Padding="10,0"
                                    Click="OnChangeExampleClick"
                                    Content="예제 바꾸기"
                                    FontSize="11"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Tag="{Binding}"
                                    Visibility="{Binding CanHaveExample, Converter={StaticResource BoolToVis}}"
                                    Width="80" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</support:DentalWindow>
